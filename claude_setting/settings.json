{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File \"C:/Users/user/.claude/notify.ps1\" -event input",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File \"C:/Users/user/.claude/notify.ps1\" -event stop",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File \"C:/Users/user/.claude/notify.ps1\" -event subagent_stop",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -ExecutionPolicy Bypass -NoProfile -File C:/Users/user/.claude/statusline.ps1"
  },
  "effortLevel": "high"
}
